+@@ -0,0 +1,106 @@
++#!/bin/sh
++set -eu
++
++# br_pypi_publisher installer
++# Usage: bash br_pypi_publisher/install.sh [project_root]
++
++tool_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
++repo_root=${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
++repo_root=$(CDPATH= cd -- "$repo_root" && pwd)
++
++echo "Installing br_pypi_publisher in $repo_root"
++
++# 1. Initialize and update submodules (br_pre_commit)
++if [ -f "$tool_root/.gitmodules" ]; then
++    echo "Initializing submodules..."
++    git -C "$tool_root" submodule update --init --recursive
++fi
++
++# 2. Install br_pre_commit if present
++if [ -f "$tool_root/br_pre_commit/install.sh" ]; then
++    echo "Installing br_pre_commit..."
++    bash "$tool_root/br_pre_commit/install.sh" "$repo_root"
++fi
++
++# 3. Create convenience publish script in project root
++publish_script="$repo_root/publish"
++cat > "$publish_script" <<'EOF'
++#!/bin/sh
++set -eu
++# Convenience script to run br_pypi_publisher
++exec "$(dirname "$0")/br_pypi_publisher/scripts/publish_to_pypi.sh" "$@"
++EOF
++chmod +x "$publish_script"
++echo "Created $publish_script"
++
++# 4. Create .env.example if it doesn't exist
++if [ ! -f "$repo_root/.env.example" ]; then
++    cat > "$repo_root/.env.example" <<'EOF'
++# PyPI API Token for publishing
++# Get yours at: https://pypi.org/manage/account/token/
++PYPI_API_KEY=pypi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
++EOF
++    echo "Created .env.example"
++fi
++
++# 5. Create .br-pypi-publisher.toml.example if it doesn't exist
++if [ ! -f "$repo_root/.br-pypi-publisher.toml.example" ]; then
++    cat > "$repo_root/.br-pypi-publisher.toml.example" <<'EOF'
++# br_pypi_publisher configuration
++# Copy to .br-pypi-publisher.toml and customize
++
++[tool.br_pypi_publisher]
++# Branch to release from (default: "main")
++# release_branch = "main"
++
++# Package name for PyPI URL display
++# package_name = "my-package"
++
++# Custom changelog path (default: "CHANGELOG.md")
++# changelog_path = "CHANGELOG.md"
++
++# Skip pre-commit checks (not recommended)
++# skip_precommit = false
++
++# Custom build command (default: "python -m build")
++# build_command = "python -m build"
++
++# Custom twine upload command
++# twine_command = "twine upload dist/*"
++EOF
++    echo "Created .br-pypi-publisher.toml.example"
++fi
++
++# 6. Ensure CHANGELOG.md exists
++if [ ! -f "$repo_root/CHANGELOG.md" ]; then
++    cat > "$repo_root/CHANGELOG.md" <<'EOF'
++# Changelog
++
++All notable changes to this project will be documented in this format.
++
++The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/),
++and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).
++EOF
++    echo "Created CHANGELOG.md"
++fi
++
++# 7. Add br_pypi_publisher to .gitignore if not already there
++if [ -f "$repo_root/.gitignore" ]; then
++    if ! grep -q "br_pypi_publisher/" "$repo_root/.gitignore"; then
++        echo "br_pypi_publisher/" >> "$repo_root/.gitignore"
++        echo "Added br_pypi_publisher/ to .gitignore"
++    fi
++else
++    echo "br_pypi_publisher/" > "$repo_root/.gitignore"
++    echo "Created .gitignore with br_pypi_publisher/"
++fi
++
++echo ""
++echo "Installation complete!"
++echo ""
++echo "Next steps:"
++echo "  1. Copy .env.example to .env and add your PYPI_API_KEY"
++echo "  2. Ensure pyproject.toml has a version field"
++echo "  3. Run ./publish (or ./publish minor/major/bug fix) from project root"
++echo ""
++echo "For more info, see: $tool_root/README.md"
+\ No newline at end of file
+
